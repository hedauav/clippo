    "check:overflow": "node scripts/check-overflow.mjs",
    "doctor": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/doctor.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:direct": "node scripts/migrate-deploy.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "db:local": "node scripts/pg-local.mjs",
    "e2e:chain": "node scripts/e2e-chain.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
