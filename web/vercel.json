{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/uploads/**/route.ts": { "maxDuration": 60 },
    "src/app/api/ai-video/**/route.ts": { "maxDuration": 300 },
    "src/app/api/wizard/**/route.ts": { "maxDuration": 60 },
    "src/app/api/assistant/**/route.ts": { "maxDuration": 60 },
    "src/app/api/submissions/route.ts": { "maxDuration": 120 },
    "src/app/api/campaigns/*/deal/route.ts": { "maxDuration": 60 },
    "src/app/api/campaigns/*/agent/route.ts": { "maxDuration": 60 },
    "src/app/api/campaigns/*/split/propose/route.ts": { "maxDuration": 60 },
    "src/app/api/chain/sync/route.ts": { "maxDuration": 120 },
    "src/app/api/snapshots/refresh/route.ts": { "maxDuration": 300 },
    "src/app/api/cron/**/route.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/chain-sync", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/video-jobs", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/snapshots-refresh", "schedule": "0 6,12,18 * * *" },
    { "path": "/api/cron/snapshots-freeze", "schedule": "10 0 * * *" },
    { "path": "/api/cron/status-ladder", "schedule": "30 0 * * *" }
  ]
}
