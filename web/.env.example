# Clippo web/backend environment. Everything below is REAL: there are no mock modes. A missing credential makes the
# affected endpoint answer 503 NOT_CONFIGURED ("not configured: set X"). Run `npm run doctor` to check this file.

# ---------- Core ----------
# Postgres (Neon). Use the POOLED connection string for the app. For local dev without Postgres: `npm run db:local`
# starts a Postgres-compatible server on :5433 (PGlite) -> DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true&sslmode=disable"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Apply migrations: npx prisma migrate deploy   (Neon: set DIRECT_URL-style non-pooled URL for migrate if the pooler rejects DDL)
# Tests use their own throwaway Postgres automatically; set TEST_DATABASE_URL only to use a real empty disposable one.
# Dev: optional (falls back to an insecure built-in secret, so wallet sign-in works with no setup). Production: REQUIRED.
SESSION_SECRET="change-me-to-a-long-random-string"   # REQUIRED in production; also keys the OAuth-token encryption
ADMIN_WALLETS="0xAdmin000000000000000000000000000000000001"   # comma-separated; get the ADMIN role on login
CRON_SECRET=""                                         # lets cron/CRE call POST /api/snapshots/refresh (x-cron-secret header)
SIWE_DOMAIN=""                                         # default: request Host
# Dev-only wallet header/unsigned sign-in (ignored in production)
ALLOW_WALLET_HEADER="true"

# ---------- Chain (Arc testnet) ----------
ARC_RPC_URL="https://rpc.testnet.arc.io"   # official docs value (rpc.testnet.arc.network also answers); explorer https://explorer.testnet.arc.io
ARC_CHAIN_ID="5042002"
USDC_ADDRESS="0x3600000000000000000000000000000000000000"
ESCROW_ADDRESS=""                 # REQUIRED for fund/claim/approve/split (503 NOT_CONFIGURED otherwise). From contracts deploy output.
ESCROW_DEPLOY_BLOCK="0"
PROFILE_ADDRESS=""                # ClippoCreatorProfile (FEATURE_TOKENIZATION)
REFERRAL_ADDRESS=""               # ClippoReferral (FEATURE_REFERRAL; optional on-chain freeze mirror)
REPORT_RECEIVER_ADDRESS=""        # ClippoReportReceiver (CRE forwarder target; informational)
UPDATER_PRIVATE_KEY=""            # server signer registered via ClippoCreatorProfile.setUpdater (and referral guardian). TESTNET KEY ONLY.
CIRCLE_FAUCET_URL="https://faucet.circle.com"   # shown to users who need testnet USDC / gas (also in GET /api/chain/config)
PLATFORM_CAMPAIGNER_FEE_BPS="25"  # fallbacks used only when the escrow cannot be read
PLATFORM_CREATOR_FEE_BPS="25"
RETENTION_DAYS="7"
HIGH_VALUE_THRESHOLD_USDC="1000"

# ---------- World ID 4.0 (Developer Portal: app_id, rp_id, signing key) ----------
WORLD_ID_APP_ID=""
WORLD_ID_RP_ID=""
WORLD_ID_SIGNING_KEY=""           # server-only secret; signs rp_context (POST /api/worldid/rp-signature)
WORLD_ID_ACTION="clippo-creator-signup"
WORLD_ID_ENVIRONMENT="production" # "staging" (simulator) or "sandbox" (World ID Sandbox app) while testing
# Optional on-chain re-check of 4.0 proofs (World Chain prod 0x00000000009E00F9FE82CfeeBB4556686da094d7, Arc prod WorldIDSatellite 0x304E14e4dC0508C0927e3b307a2C18422C07E394)
WORLD_ID_ONCHAIN_VERIFIER=""
WORLD_ID_ONCHAIN_RPC_URL=""
# Approval actions the Portal must also contain (unlimited verifications): clippo-approve-campaign, clippo-approve-split

# ---------- AI ----------
# Pick ONE provider (or set both and choose with LLM_PROVIDER). Auto-selection when LLM_PROVIDER is empty:
# only GEMINI_API_KEY -> gemini; only ANTHROPIC_API_KEY -> anthropic; both -> anthropic; neither -> 503 NOT_CONFIGURED.
LLM_PROVIDER=""                   # anthropic | gemini
# Free Gemini key (no billing): https://aistudio.google.com/apikey . The same GEMINI_API_KEY is reused for AI video below.
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL=""              # default gemini-3.5-flash-lite (free tier, structured JSON); e.g. gemini-3.8-flash for higher quality
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Free-tier protection (all optional)
LLM_RPM_LIMIT=""                  # provider calls per minute; default 10 for gemini, unlimited for anthropic
LLM_MAX_CONCURRENCY="2"
LLM_MAX_RETRIES="3"               # exponential backoff + Retry-After on 429/5xx
LLM_CACHE_TTL_SECONDS="600"       # identical requests are answered from memory; 0 disables
LLM_MAX_INPUT_CHARS=""            # input budget (~4 chars/token); default 48000 gemini, 120000 anthropic
VERIFIER_CONFIDENCE_THRESHOLD="0.75"   # below this a verdict becomes NEEDS_HUMAN

# ---------- Platforms ----------
YOUTUBE_API_KEY=""                # YouTube Data API v3 (views, metadata, availability); captions are read from the public caption track
X_BEARER_TOKEN=""                 # X API v2 app bearer token (tier must allow reads). X exposes no audio: clips go to human review
# Instagram API with Instagram Login (creator OAuth; Business/Creator accounts). Redirect URI = <site>/api/channels/instagram/oauth/callback
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI=""
INSTAGRAM_POST_CONNECT_URL="/"
ANOMALY_MIN_DELTA="5000"
ANOMALY_MULTIPLIER="5"

# ---------- Source clips / AI video ----------
STORAGE_DIR=""                    # default ./storage (local disk). Use a persistent volume in production.
SOURCE_MAX_BYTES="524288000"      # upload cap, default 500 MB
VIDEO_GEN_PROVIDER="gemini"       # gemini (default) | http
# GEMINI_API_KEY (above) is shared with AI text. Video needs billing on that project (paid tier only).
GEMINI_VIDEO_MODEL="gemini-omni-1.1-flash"   # Veo 3.1 preview models were shut down 2026-10-22
VIDEO_GEN_MAX_BYTES="209715200"
VIDEO_GEN_URL=""                  # only for VIDEO_GEN_PROVIDER=http
VIDEO_GEN_KEY=""
APPEAL_SLA_HOURS="72"

# ---------- Fiat on-ramp (Transak, staging by default) ----------
TRANSAK_API_KEY=""
TRANSAK_API_SECRET=""
TRANSAK_ENV="staging"             # production to go live
TRANSAK_REFERRER_DOMAIN=""        # your site domain as registered with Transak (default: request host)
TRANSAK_NETWORK=""                # Transak network slug for Arc if/when supported
TRANSAK_REDIRECT_URL=""
# Webhook URL to register in the Transak dashboard: <site>/api/onramp/webhook (JWT verified with the partner access token)

# ---------- Optional modules (OFF by default; see contracts/LEGAL_REVIEW.md) ----------
FEATURE_TOKENIZATION="false"
FEATURE_REFERRAL="false"
FEATURE_STATUS_LADDER="false"
REFERRAL_CUT_BPS="500"
REFERRAL_CAP_USDC="100"
REFERRAL_COOLDOWN_HOURS="24"

# ---------- World Agent Pass (AgentKit): the AI split proposer ----------
# Agent wallet private key (server-only). Register its address ONCE with: npx @worldcoin/agentkit-cli register <address>
AGENT_PASS_PRIVATE_KEY=""
# "1" = DEMO ONLY: derive a local agent wallet and treat it as registered to a FAKE human (Agent Pass uses fake identities). Records are labelled demo.
AGENT_PASS_DEMO=""
# Optional World Chain RPC for the AgentBook lookup (default: the public RPC)
WORLD_CHAIN_RPC_URL=""

# ---------- Vercel / serverless (see ../docs/DEPLOY_ENV.md) ----------
DIRECT_URL=""                     # Neon NON-pooled URL, used only by `npm run db:migrate:direct`
STORAGE_PROVIDER=""               # local (dev default) | blob (Vercel; private Blob store via BLOB_STORE_ID or BLOB_READ_WRITE_TOKEN)
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_TEST_DEPLOY=""        # 1 = TESTNET banner + noindex (build-time)
RATE_LIMIT=""                     # 0 disables the Postgres rate limiter (on by default in production)
